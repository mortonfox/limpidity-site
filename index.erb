<table align="center">

  <% current.each { |(num, title)|
    fname = format('strips/limps%02d.gif', num)
    imgsize = get_image_size.call(fname)
%>

<tr>
<td>

  <p class="striptitle">#<%= num %>: <%= title %></p>

  <p class="frontstrip"><a href="show<%= num %>.htm"><img src="<%= fname %>" <%= imgsize %> border="0" alt="Limpidity #<%= num %>: <%= title %>" /></a></p>

</td>
</tr>

  <% } %>

</table>

