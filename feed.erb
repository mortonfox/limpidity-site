<?xml version="1.0" ?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<atom:link href="http://limpidity.com/feed.xml" rel="self" type="application/rss+xml" />

<title>Webcomics: Limpidity</title>
<description>A webcomic about a fox and a hare living in modern suburbia.</description>
<link>http://www.limpidity.com</link>
<managingEditor><%= email %></managingEditor>

<% archive.first(15).each { |num, title|
    fname = format('strips/limps%02d.gif', num)
    imgsize = get_image_size.call(fname)
%>
    <item>
    <title>Limpidity <%= num %>: <%= title %></title>
    <link>http://www.limpidity.com/<%= fname %></link>
    <description>&lt;img src=&quot;http://www.limpidity.com/<%= fname %>&quot; <%= imgsize %> alt=&quot;Limpidity #<%= num %>: <%= title %>&quot;&gt;</description>
    </item>

<% } %>

</channel>
</rss>
